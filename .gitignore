# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Platform build output, native build caches, and coverage reports
/android/build/
**/.gradle/
**/.cxx/
**/.externalNativeBuild/
/coverage/
*.apk
*.aab
*.ipa

# Machine-specific Android SDK paths and private signing credentials
**/local.properties
**/key.properties
*.jks
*.keystore
*.p12
*.pfx

# Local environment values; keep sanitized templates shareable
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local Wallet databases, lock files, and exported backups
*.isar
*.isar.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
